[
  { "a": "https://example.com/page/", "b": "https://example.com/page", "same": true, "why": "trailing slash" },
  { "a": "http://example.com/page/", "b": "https://example.com/page/", "same": true, "why": "scheme" },
  { "a": "https://Example.COM/page/", "b": "https://example.com/page/", "same": true, "why": "host case" },
  { "a": "https://example.com/page/#top", "b": "https://example.com/page/", "same": true, "why": "fragment" },
  { "a": "http://Example.com/page#x", "b": "https://example.com/page/", "same": true, "why": "all four at once" },
  { "a": "https://example.com/", "b": "https://example.com", "same": true, "why": "home, trailing slash" },
  { "a": "https://example.com/page/?ref=x", "b": "https://example.com/page/", "same": false, "why": "query string" },
  { "a": "https://example.com/page/?ref=x", "b": "https://example.com/page?ref=x", "same": true, "why": "same query, trailing slash" },
  { "a": "https://www.example.com/page/", "b": "https://example.com/page/", "same": false, "why": "www is another host" },
  { "a": "https://example.com/Page/", "b": "https://example.com/page/", "same": false, "why": "path case matters" },
  { "a": "https://example.com/other/", "b": "https://example.com/page/", "same": false, "why": "different path" },
  { "a": "https://example.com:8080/page/", "b": "https://example.com/page/", "same": false, "why": "port" },
  { "a": "  https://example.com/page/ ", "b": "https://example.com/page", "same": true, "why": "surrounding whitespace" }
